#!/usr/bin/env bash
#
# check-no-local-details — refuse to let one deployment's details into the repo.
#
# This repository is public and is deployed into private environments. Anything
# specific to a deployment belongs in .env (gitignored) or in the operator's own
# ~/.claude config — never in tracked files, and never in a commit message,
# which cannot be corrected later without rewriting published history.
#
# Run over the working tree (default) or over a commit range:
#   scripts/check-no-local-details
#   scripts/check-no-local-details origin/main..HEAD
#
# Exits non-zero if anything matches. Placeholder-looking values are allowed:
# example.com, example.org, 123456789012, TICKET-123 and friends.

set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

range="${1:-}"

# Classes of value that identify a real deployment.
patterns=(
    # credentials and keys
    '(api[_-]?key|secret|token|password)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9+/]{20,}'
    # cloud resource identifiers
    # a cloud ARN carrying a real account number (the documentation
    # placeholders 1234.. / 9999.. are fine)
    'arn:aws[a-z-]*:[a-z0-9-]*:[a-z0-9-]*:(?!123456789012|999999999999|000000000000)[0-9]{12}'
    '\b(sg|i|vpc|subnet|ami)-[0-9a-f]{8,}'
    # a 12-digit AWS account number that is not the documentation placeholder
    '\b(?!123456789012|999999999999|000000000000)[0-9]{12}\b'
    # private network addresses
    '\b(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}\b'
    # an email or hostname that is not an example/placeholder domain
    # an email whose domain is not an RFC 2606 reserved name
    '[a-zA-Z0-9._%+-]+@(?![a-zA-Z0-9.-]*\.example\b)(?!example\.(com|org|net)\b)[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}'
    # machine-specific home directories
    '/(home|Users)/[a-z0-9_-]+'
)

fail=0

# A check that cannot fail is worse than no check: verify the matcher works
# before trusting a clean result.
if ! printf 'x@real.example.net\n' | grep -qP '[a-z]+@(?!example\.com\b)[a-z.]+' 2>/dev/null; then
    echo "error: this script needs grep with PCRE support (-P)" >&2
    exit 2
fi

scan_text() {
    local label="$1" text="$2" p
    for p in "${patterns[@]}"; do
        local hit
        hit=$(printf '%s' "$text" | grep -nP "$p" 2>/dev/null | head -5) || true
        if [ -n "$hit" ]; then
            printf '%s:\n' "$label"
            printf '%s\n' "$hit" | sed 's/^/    /'
            fail=1
        fi
    done
}

if [ -n "$range" ]; then
    echo "Checking commit messages in $range"
    while read -r sha; do
        [ -z "$sha" ] && continue
        scan_text "commit $sha" "$(git log -1 --format='%s%n%b' "$sha")"
    done < <(git rev-list "$range" 2>/dev/null)
    echo "Checking added lines in $range"
    scan_text "diff" "$(git diff "$range" -- . 2>/dev/null | grep '^+' || true)"
else
    echo "Checking tracked files"
    for p in "${patterns[@]}"; do
        hit=$(git ls-files -z | xargs -0 grep -InP "$p" 2>/dev/null | head -10) || true
        if [ -n "$hit" ]; then
            printf '%s\n' "$hit" | sed 's/^/    /'
            fail=1
        fi
    done
fi

if [ "$fail" -ne 0 ]; then
    cat >&2 <<'EOF'

Found values that look specific to one deployment. Move them to .env, to the
operator's own ~/.claude config, or replace them with a placeholder
(example.com or anything.example, 123456789012, TICKET-123).

If a match is a false positive, widen the allowed-placeholder list in
scripts/check-no-local-details rather than ignoring the check.
EOF
    exit 1
fi
echo "Clean: nothing deployment-specific found."
