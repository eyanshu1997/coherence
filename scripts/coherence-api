#!/usr/bin/env bash
#
# coherence-api — call the local coherence API with authentication.
#
# Every mutating endpoint requires a Bearer token when COHERENCE_API_KEY is
# configured. A browser is authenticated by the auth proxy instead, but agents
# and skills reach the API with curl, which carries no credentials — so those
# calls get 401. This wrapper reads the key out of the server's own .env and
# adds the header, which keeps the secret in one place instead of inlined into
# every agent doc.
#
# Usage:
#   coherence-api /reply-comment '{"folder":"f","file":"s","ts":"...","reply":"x"}'
#   coherence-api /acknowledge   '{"folder":"f","file":"s","ts":"..."}'
#   coherence-api '/doc-history?folder=f&file=s'
#
# A JSON body makes the call a POST; without one it is a GET. The path may be
# given with or without the /comment-api prefix. Exits non-zero on an HTTP
# error, printing the server's JSON error body.

set -euo pipefail

path="${1:-}"
if [ -z "$path" ]; then
    echo "usage: coherence-api <path> [json-body]" >&2
    exit 2
fi
body="${2:-}"

env_file="${COHERENCE_HOME:-$HOME/coherence}/.env"

# A request body is written to a private temp file rather than passed inline, so
# it is never visible in argv either.
tmp_body=$(mktemp "${TMPDIR:-/tmp}/coherence-api.XXXXXX")
chmod 600 "$tmp_body"
trap 'rm -f "$tmp_body"' EXIT INT TERM

# Read one KEY=value from the server's .env, stripping inline comments,
# surrounding quotes and trailing space. Values already exported win.
read_env() {
    [ -f "$env_file" ] || return 0
    sed -n "s/^[[:space:]]*$1=//p" "$env_file" \
        | tail -1 \
        | sed 's/[[:space:]]#.*$//; s/^"//; s/"$//; s/^'\''//; s/'\''$//; s/[[:space:]]*$//'
}

key="${COHERENCE_API_KEY:-$(read_env COHERENCE_API_KEY)}"
port="${COHERENCE_PORT:-$(read_env COHERENCE_PORT)}"
port="${port:-9181}"

case "$path" in
    /comment-api/*) ;;
    /*)  path="/comment-api$path" ;;
    *)   path="/comment-api/$path" ;;
esac

args=(--silent --show-error --fail-with-body)
if [ -n "$body" ]; then
    # --data-binary @- would read a file if the body began with "@"; the
    # explicit form below cannot be reinterpreted that way.
    args+=(-X POST -H "Content-Type: application/json")
fi

# The token must not go in argv: /proc/<pid>/cmdline is world-readable here, so
# any local process can read it out of the running curl. Pass it through a
# config file on stdin instead, which only this curl can see.
run_curl() {
    if [ -n "$key" ]; then
        printf 'header = "Authorization: Bearer %s"\n' "$key" \
            | curl "${args[@]}" --config - "$@" "http://127.0.0.1:${port}${path}"
    else
        curl "${args[@]}" "$@" "http://127.0.0.1:${port}${path}"
    fi
}

if [ -n "$body" ]; then
    printf '%s' "$body" > "$tmp_body"
    run_curl --data-binary "@$tmp_body"
else
    run_curl
fi
